{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "native-works",
  "compatibility_date": "2026-06-20",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public"
  },
  "build": {
    "command": "npm run build"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
